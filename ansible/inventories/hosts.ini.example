# Hosts whose clock the Kubernetes nodes depend on.
#
# EKS (this project): the worker nodes run the EKS-optimised AL2023 AMI, which
#   already ships chrony pointed at the Amazon Time Sync Service
#   (169.254.169.123). docs/eks-run.md shows `chronyc` output collected from
#   every node through SSM Run Command.
#
# Use this playbook for hosts that do NOT come with that setup: self-managed
# EC2 workers on a custom AMI, bastion hosts, self-hosted CI runners.
# The EKS nodes have no SSH port open; reach such hosts through a bastion or
# SSM Session Manager (the node role has AmazonSSMManagedInstanceCore).

[k8s_workers]
# worker-1 ansible_host=10.0.1.11 ansible_user=ec2-user
# worker-2 ansible_host=10.0.2.12 ansible_user=ec2-user
