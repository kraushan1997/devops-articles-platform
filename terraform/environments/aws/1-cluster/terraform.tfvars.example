# cp terraform.tfvars.example terraform.tfvars   (terraform.tfvars is git-ignored)
aws_region         = "us-east-1"
eks_cluster_name   = "articles-eks"
api_allowed_cidrs  = ["203.0.113.10/32"] # your public IP: curl -s https://checkip.amazonaws.com
single_nat_gateway = true                # demo/cost saving: 1 NAT instead of 3
